# ─── Credential vault ────────────────────────────────────────────────────────
# 64 hex characters (32 bytes). Generate once with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Every site password in data/agent.db is encrypted with this key. Lose it and
# every stored account password is unrecoverable — keep a copy somewhere safe.
VAULT_KEY=

# ─── Google Sheets ───────────────────────────────────────────────────────────
# Path to a Google Cloud service-account JSON key with the Sheets and Drive
# scopes enabled. See docs/SETUP-GOOGLE.md.
GOOGLE_SERVICE_ACCOUNT_JSON=./secrets/service-account.json

# The team's existing manual tracker. Read-only: the agent never writes here.
SOURCE_SHEET_ID=1twdRsEZF7P-aH8Ku7BB1YWSuZUo5LBSjzxEhhBCuWGA

# Created by `npm run sheet:create`, then pasted back here (or stored per client
# in config/clients/<id>.json). This is the sheet the agent owns and writes to.
AGENT_SHEET_ID=

# Google account to share every agent-created sheet with, so you can open it.
# A service account's own Drive is invisible to you; without this you cannot
# see the sheet it creates.
SHEET_SHARE_WITH=

# ─── LLM (OpenAI-compatible; Groq by default) ────────────────────────────────
# Same arrangement as tapify-voice-agent: one OpenAI-compatible driver, swap the
# base URL to change vendor. Groq keys start with gsk_.
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_MAX_TOKENS=2048

# ─── Web search (site discovery) ─────────────────────────────────────────────
# Optional: `npm run discover:seed` loads the curated catalog with no key at all.
# A key is only needed to find sites beyond that list.
#   serper      — serper.dev, Google results, pay per call, 2500 free to start
#   google_cse  — Programmable Search, 100 queries/day free, needs key + cx
#   brave       — Brave Search API, free tier, independent index
SEARCH_PROVIDER=
SERPER_API_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
BRAVE_API_KEY=

# Minimum gap between two requests to the SAME host while crawling. Lower this
# and you will be rate-limited or blocked by the platforms you depend on.
FETCH_HOST_INTERVAL_MS=1500

# ─── Operator notifications (Assist Mode) ────────────────────────────────────
# When a CAPTCHA or OTP stops the agent, it pings this number through the
# existing Tapify WhatsApp sender. Leave blank to log to the console only.
OPERATOR_WHATSAPP=
TAPIFY_WA_ENDPOINT=

# ─── Runtime ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info
# Playwright runs headful on your PC so you can clear CAPTCHAs yourself.
HEADLESS=false
